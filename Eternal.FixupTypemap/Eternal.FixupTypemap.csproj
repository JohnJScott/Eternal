<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <VersionPrefix>1.0.2</VersionPrefix>	
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>A utility to audit and fix the Perforce typemap.</Title>
    <GenerateSbom>true</GenerateSbom>
    <!-- This project's solution is Eternal.FixupTypemap.slnx (the newer XML
         solution format), not the "$(MSBuildProjectName).sln" the shared
         Directory.Build.targets default assumes - override it explicitly. -->
    <SbomSolutionPath>$(MSBuildThisFileDirectory)../Eternal.FixupTypemap.slnx</SbomSolutionPath>
    <Authors>JohnJScott</Authors>
    <Company>Eternal Developments, LLC</Company>
    <Copyright>Copyright Eternal Developments, LLC. All Rights Reserved.</Copyright>
    <PackageProjectUrl>http://eternaldevelopments.com/docs/index.html</PackageProjectUrl>
    <PackageReadmeFile>ReadMe.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/JohnJScott/Eternal</RepositoryUrl>
    <PackageTags>Perforce;Typemap</PackageTags>
    <PackAsTool>True</PackAsTool>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>	
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <WarningLevel>9999</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <WarningLevel>9999</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Eternal.ConsoleUtilities" Version="1.0.13" />
    <PackageReference Include="Eternal.PerforceUtilities" Version="1.0.15" />
    <PackageReference Include="p4api.net" Version="2026.1.299.3959" />
  </ItemGroup>

  <ItemGroup>
    <None Update="ReadMe.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
